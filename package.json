{
  "name": "prototypo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.23.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "antique.ptf": "byte-foundry/antique.ptf#feat/simplified-parameters",
    "babel-plugin-lodash": "lodash/babel-plugin-lodash#master",
    "bluebird": "^3.7.2",
    "classnames": "^2.3.2",
    "cleave.js": "^0.7.14",
    "core-js": "3",
    "country-data": "^0.0.31",
    "diff": "^3.0.1",
    "draft-js": "~0.9.1",
    "elzevir.ptf": "byte-foundry/elzevir.ptf#feat/simplified-parameters",
    "escape-string-regexp": "^1.0.5",
    "gfnt.ptf": "byte-foundry/spectral.ptf#feat/simplified-parameters",
    "john-fell.ptf": "byte-foundry/john-fell.ptf#feat/simplified-parameters",
    "jszip": "^3.10.1",
    "lifespan": "FranzPoize/lifespan#master",
    "lodash": "^4.17.21",
    "memoize-immutable": "^3.0.0",
    "moment": "^2.29.4",
    "nexus-events": "franzpoize/nexus-events#master",
    "nexus-flux": "FranzPoize/nexus-flux#master",
    "normalize.css": "^8.0.1",
    "opentype.js": "^1.3.4",
    "please-wait": "0.0.5",
    "prop-types": "^15.6.1",
    "query-string": "^4.2.3",
    "react": "^16.4.0",
    "react-addons-css-transition-group": "^15.6.2",
    "react-addons-pure-render-mixin": "^15.6.2",
    "react-apollo": "^1.4.3",
    "react-dom": "^16.4.0",
    "react-draggable": "^2.2.1",
    "react-dropzone": "^3.13.1",
    "react-hot-loader": "^4.0.0",
    "react-joyride": "^1.4.7",
    "react-json-pretty": "^1.6.3",
    "react-markdown": "^2.4.4",
    "react-motion-flip": "Aldrian/react-motion-flip#master",
    "react-onclickoutside": "^6.1.1",
    "react-portal": "^3.1.0",
    "react-router": "3.2.1",
    "react-scrollbar": "^0.5.0",
    "react-select": "^1.0.0-beta13",
    "react-tippy": "^1.2.2",
    "react-transition-group": "^2.2.0",
    "regenerator-runtime": "^0.13.3",
    "remutable": "FranzPoize/remutable#master",
    "svg-inline-react": "3.1.0",
    "tether": "^1.1.0",
    "tutorial-content": "byte-foundry/tutorial-content#master",
    "venus.ptf": "https://github.com/byte-foundry/venus.ptf#feat/simplified-params",
    "whatwg-fetch": "^0.9.0",
    "xxhashjs": "^0.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-flow": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-storyshots": "^3.1.8",
    "@storybook/react": "^3.1.8",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-eslint": "7.2.3",
    "babel-jest": "^22.2.0",
    "babel-plugin-dynamic-import-node": "^1.2.0",
    "babel-plugin-transform-es2015-modules-commonjs": "^6.26.0",
    "chai": "^3.4.1",
    "envify": "^3.4.0",
    "eslint": "^4.19.1",
    "eslint-config-airbnb": "^15.0.1",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-jsx-a11y": "^5.0.1",
    "eslint-plugin-prettier": "^2.6.0",
    "eslint-plugin-react": "^7.7.0",
    "husky": "^0.14.3",
    "jest": "^22.2.1",
    "jshint-stylish": "~2.0.0",
    "lint-staged": "^6.1.1",
    "lodash.assign": "^3.2.0",
    "mocha": "^2.3.4",
    "nightwatch": "^0.8.15",
    "playwright-bdd": "^9.2.0",
    "prettier": "^1.10.2",
    "prettier-eslint-cli": "4.7.1",
    "prototypo-flux-testing": "0.0.1",
    "react-storybook-decorator-background": "^1.0.5",
    "react-test-renderer": "^16.4.1",
    "sass": "^1.69.5",
    "through": "^2.3.7",
    "vatrates": "^1.2.1",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "description": "Prototypo, kickstarting font creation",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "node scripts/copy-templates.mjs && vite",
    "build": "node scripts/copy-templates.mjs && vite build",
    "build:dist": "node scripts/copy-templates.mjs && vite build",
    "preview": "vite preview",
    "build:storybook": "build-storybook",
    "start": "node scripts/copy-templates.mjs && vite",
    "mcp": "node mcp/server.mjs",
    "storybook": "start-storybook -p 6006",
    "test": "NODE_PATH=$pwd/node_modules:$(pwd)/app jest",
    "test:unit": "node --import ./__tests__/unit/register-loader.mjs --test __tests__/unit/*.test.mjs",
    "test:bdd": "bddgen && playwright test",
    "lint:files": "prettier-eslint $(find ./app/scripts -type f -regex '.*\\.jsx?') stories/** .babelrc .eslintrc",
    "lint": "pnpm run lint:files -- --list-different",
    "format": "pnpm run lint:files -- --write",
    "precommit": "lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/byte-foundry/prototypo.git"
  },
  "author": "YM & LRB",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/byte-foundry/prototypo/issues"
  },
  "jest": {
    "testRegex": "/__tests__/.*\\.(ts|tsx|js)$",
    "moduleFileExtensions": [
      "js",
      "json",
      "jsx"
    ],
    "moduleDirectories": [
      "node_modules",
      "bower_components",
      "shared"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|scss)$": "<rootDir>/__mocks__/styleMock.js"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always",
    "useTabs": true,
    "bracketSpacing": false
  },
  "lint-staged": {
    "stories/**": [
      "prettier-eslint --write",
      "git add"
    ],
    "app/scripts/**/**.{js,jsx}": [
      "prettier-eslint --write",
      "git add"
    ]
  },
  "packageManager": "pnpm@11.25.0"
}
